import 'package:flutter/material.dart';

void main() {
  runApp(const StreakoApp());
}

enum PriorityLevel { p1, p2, p3 }
enum TaskStatus { pending, inProgress, done, skipped }

class HabitItem {
  final String id;
  final String title;
  final String category;
  final PriorityLevel priority;
  final String targetUnit;
  final TaskStatus status;
  final String? todayNote;
  final String scheduledTime;
  int streakDays;
  final Map<String, bool> weeklyCompletion;

  HabitItem({
    required this.id,
    required this.title,
    required this.category,
    this.priority = PriorityLevel.p2,
    this.targetUnit = 'Daily',
    this.status = TaskStatus.pending,
    this.todayNote,
    required this.scheduledTime,
    this.streakDays = 0,
    required this.weeklyCompletion,
  });
}

class StreakoApp extends StatelessWidget {
  const StreakoApp({Key? key}) : super(key: key);

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Streako Habit Tracker',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        primarySwatch: Colors.teal,
        scaffoldBackgroundColor: const Color(0xFFF7F9FB),
      ),
      home: const HabitTrackerHomeScreen(),
    );
  }
}

class HabitTrackerHomeScreen extends StatefulWidget {
  const HabitTrackerHomeScreen({Key? key}) : super(key: key);

  @override
  State<HabitTrackerHomeScreen> createState() => _HabitTrackerHomeScreenState();
}

class _HabitTrackerHomeScreenState extends State<HabitTrackerHomeScreen> {
  final List<HabitItem> _habits = [
    HabitItem(
      id: '1',
      title: 'Client Feature Build',
      category: 'Work',
      priority: PriorityLevel.p1,
      targetUnit: '3.0 hrs',
      todayNote: 'Push PR to GitHub repository',
      scheduledTime: '10:00 AM',
      streakDays: 4,
      weeklyCompletion: {
        'Mon': true,
        'Tue': true,
        'Wed': true,
        'Thu': true,
        'Fri': false,
        'Sat': false,
        'Sun': false,
      },
    ),
    HabitItem(
      id: '2',
      title: 'Morning Workout & Cycling',
      category: 'Health',
      priority: PriorityLevel.p2,
      targetUnit: '45 mins',
      todayNote: 'Cardio & stretch',
      scheduledTime: '06:00 AM',
      streakDays: 5,
      weeklyCompletion: {
        'Mon': true,
        'Tue': true,
        'Wed': true,
        'Thu': false,
        'Fri': false,
        'Sat': false,
        'Sun': false,
      },
    ),
  ];

  void _toggleDay(HabitItem item, String dayKey) {
    setState(() {
      final current = item.weeklyCompletion[dayKey] ?? false;
      item.weeklyCompletion[dayKey] = !current;
      if (!current) {
        item.streakDays += 1;
      } else if (item.streakDays > 0) {
        item.streakDays -= 1;
      }
    });
  }

  void _openAddModal() {
    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(20)),
      ),
      builder: (ctx) => AddHabitSheet(
        onSave: (newHabit) {
          setState(() {
            _habits.insert(0, newHabit);
          });
        },
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    int totalLoggedDays = 0;
    int completedDays = 0;

    for (var h in _habits) {
      totalLoggedDays += h.weeklyCompletion.length;
      completedDays += h.weeklyCompletion.values.where((v) => v).length;
    }

    final double completionPercent = totalLoggedDays > 0
        ? (completedDays / totalLoggedDays) * 100
        : 0.0;

    return Scaffold(
      appBar: AppBar(
        title: const Text('Streako - Habit Tracker', style: TextStyle(fontWeight: FontWeight.bold)),
        backgroundColor: Colors.teal,
        foregroundColor: Colors.white,
        elevation: 0,
      ),
      body: ListView(
        padding: const EdgeInsets.symmetric(vertical: 12),
        children: [
          // KPI Metric Banner
          Container(
            margin: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
            padding: const EdgeInsets.all(16),
            decoration: BoxDecoration(
              color: Colors.teal.shade700,
              borderRadius: BorderRadius.circular(14),
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    const Text('Weekly Completion', style: TextStyle(color: Colors.white70, fontSize: 13)),
                    Text('${completionPercent.toStringAsFixed(1)}%',
                        style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 16)),
                  ],
                ),
                const SizedBox(height: 8),
                ClipRRect(
                  borderRadius: BorderRadius.circular(4),
                  child: LinearProgressIndicator(
                    value: totalLoggedDays > 0 ? (completedDays / totalLoggedDays) : 0,
                    backgroundColor: Colors.teal.shade900,
                    valueColor: const AlwaysStoppedAnimation<Color>(Colors.greenAccent),
                    minHeight: 8,
                  ),
                ),
                const SizedBox(height: 12),
                Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    Text('Total Habits: ${_habits.length}', style: const TextStyle(color: Colors.white, fontSize: 12)),
                    Text('Completed Marks: $completedDays', style: const TextStyle(color: Colors.white, fontSize: 12)),
                  ],
                ),
              ],
            ),
          ),
          const SizedBox(height: 8),

          // Habit Cards
          ..._habits.map((item) => HabitCardWidget(
                item: item,
                onDayToggle: (day) => _toggleDay(item, day),
              )),
        ],
      ),
      floatingActionButton: FloatingActionButton(
        backgroundColor: Colors.teal,
        foregroundColor: Colors.white,
        onPressed: _openAddModal,
        child: const Icon(Icons.add),
      ),
    );
  }
}

class HabitCardWidget extends StatelessWidget {
  final HabitItem item;
  final Function(String) onDayToggle;

  const HabitCardWidget({Key? key, required this.item, required this.onDayToggle}) : super(key: key);

  Color _priorityColor(PriorityLevel p) {
    switch (p) {
      case PriorityLevel.p1:
        return Colors.redAccent;
      case PriorityLevel.p2:
        return Colors.amber.shade800;
      case PriorityLevel.p3:
        return Colors.green;
    }
  }

  @override
  Widget build(BuildContext context) {
    final days = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
    final dayKeys = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

    return Card(
      elevation: 2,
      margin: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
      child: Padding(
        padding: const EdgeInsets.all(14),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                Container(
                  padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                  decoration: BoxDecoration(
                    color: _priorityColor(item.priority).withOpacity(0.12),
                    borderRadius: BorderRadius.circular(4),
                    border: Border.all(color: _priorityColor(item.priority)),
                  ),
                  child: Text(
                    item.priority.name.toUpperCase(),
                    style: TextStyle(fontSize: 10, fontWeight: FontWeight.bold, color: _priorityColor(item.priority)),
                  ),
                ),
                const SizedBox(width: 8),
                Expanded(
                  child: Text(item.title, style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 15)),
                ),
                Text('🔥 ${item.streakDays}d',
                    style: const TextStyle(fontWeight: FontWeight.bold, color: Colors.deepOrange)),
              ],
            ),
            const SizedBox(height: 6),
            Text('${item.category} • ${item.targetUnit} • ${item.scheduledTime}',
                style: TextStyle(color: Colors.grey.shade600, fontSize: 12)),
            const Divider(height: 18),
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: List.generate(7, (index) {
                final label = days[index];
                final key = dayKeys[index];
                final done = item.weeklyCompletion[key] ?? false;

                return InkWell(
                  onTap: () => onDayToggle(key),
                  borderRadius: BorderRadius.circular(8),
                  child: Container(
                    width: 38,
                    height: 46,
                    decoration: BoxDecoration(
                      color: done ? Colors.teal.shade50 : Colors.grey.shade100,
                      borderRadius: BorderRadius.circular(8),
                      border: Border.all(
                        color: done ? Colors.teal : Colors.grey.shade300,
                        width: done ? 1.5 : 1,
                      ),
                    ),
                    child: Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        Text(label,
                            style: TextStyle(
                              fontSize: 11,
                              fontWeight: FontWeight.bold,
                              color: done ? Colors.teal.shade900 : Colors.grey.shade600,
                            )),
                        const SizedBox(height: 2),
                        Icon(done ? Icons.check_circle : Icons.circle_outlined,
                            size: 16, color: done ? Colors.teal : Colors.grey.shade400),
                      ],
                    ),
                  ),
                );
              }),
            ),
            if (item.todayNote != null && item.todayNote!.isNotEmpty) ...[
              const SizedBox(height: 10),
              Container(
                width: double.infinity,
                padding: const EdgeInsets.all(8),
                decoration: BoxDecoration(
                  color: Colors.grey.shade50,
                  borderRadius: BorderRadius.circular(6),
                ),
                child: Text('📝 Note: ${item.todayNote!}',
                    style: TextStyle(fontSize: 12, color: Colors.grey.shade700)),
              ),
            ],
          ],
        ),
      ),
    );
  }
}

class AddHabitSheet extends StatefulWidget {
  final Function(HabitItem) onSave;

  const AddHabitSheet({Key? key, required this.onSave}) : super(key: key);

  @override
  State<AddHabitSheet> createState() => _AddHabitSheetState();
}

class _AddHabitSheetState extends State<AddHabitSheet> {
  final _titleController = TextEditingController();
  final _targetUnitController = TextEditingController(text: '30 mins');
  final _noteController = TextEditingController();
  String _selectedCategory = 'Work';
  PriorityLevel _selectedPriority = PriorityLevel.p2;
  TimeOfDay _selectedTime = const TimeOfDay(hour: 8, minute: 0);

  void _submit() {
    final title = _titleController.text.trim();
    if (title.isEmpty) return;

    widget.onSave(HabitItem(
      id: DateTime.now().millisecondsSinceEpoch.toString(),
      title: title,
      category: _selectedCategory,
      priority: _selectedPriority,
      targetUnit: _targetUnitController.text.trim().isEmpty ? 'Daily' : _targetUnitController.text.trim(),
      todayNote: _noteController.text.trim().isEmpty ? null : _noteController.text.trim(),
      scheduledTime: _selectedTime.format(context),
      streakDays: 0,
      weeklyCompletion: {
        'Mon': false,
        'Tue': false,
        'Wed': false,
        'Thu': false,
        'Fri': false,
        'Sat': false,
        'Sun': false,
      },
    ));
    Navigator.pop(context);
  }

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: EdgeInsets.only(
        left: 20,
        right: 20,
        top: 20,
        bottom: MediaQuery.of(context).viewInsets.bottom + 20,
      ),
      child: SingleChildScrollView(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                const Text('New Habit / Work Task', style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
                IconButton(icon: const Icon(Icons.close), onPressed: () => Navigator.pop(context)),
              ],
            ),
            const SizedBox(height: 12),
            TextField(
              controller: _titleController,
              decoration: InputDecoration(
                labelText: 'Task Title',
                border: OutlineInputBorder(borderRadius: BorderRadius.circular(10)),
              ),
            ),
            const SizedBox(height: 12),
            Row(
              children: [
                Expanded(
                  child: DropdownButtonFormField<String>(
                    value: _selectedCategory,
                    decoration: InputDecoration(
                      labelText: 'Category',
                      border: OutlineInputBorder(borderRadius: BorderRadius.circular(10)),
                    ),
                    items: ['Work', 'Health', 'Learning', 'Fitness']
                        .map((c) => DropdownMenuItem(value: c, child: Text(c)))
                        .toList(),
                    onChanged: (val) => setState(() => _selectedCategory = val ?? 'Work'),
                  ),
                ),
                const SizedBox(width: 10),
                Expanded(
                  child: TextField(
                    controller: _targetUnitController,
                    decoration: InputDecoration(
                      labelText: 'Target Metric',
                      border: OutlineInputBorder(borderRadius: BorderRadius.circular(10)),
                    ),
                  ),
                ),
              ],
            ),
            const SizedBox(height: 12),
            TextField(
              controller: _noteController,
              decoration: InputDecoration(
                labelText: 'Daily Note (Optional)',
                border: OutlineInputBorder(borderRadius: BorderRadius.circular(10)),
              ),
            ),
            const SizedBox(height: 16),
            SizedBox(
              width: double.infinity,
              height: 46,
              child: ElevatedButton(
                style: ElevatedButton.styleFrom(
                  backgroundColor: Colors.teal,
                  shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
                ),
                onPressed: _submit,
                child: const Text('Add Task', style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
              ),
            ),
          ],
        ),
      ),
    );
  }
}
